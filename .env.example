# ── Servidor ────────────────────────────────────────────────────────────────
# NODE_ENV=production activa: HTTPS obligatorio, validación estricta de
# variables, Swagger cerrado y trust proxy = 1 (ver README → Seguridad).
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (lista separada por comas, SIN "*" ni ruta; una "/" final se ignora).
# En producción deben ser https://. Ej.: https://app.imvolt.ec,https://www.imvolt.ec
ALLOWED_ORIGIN=http://localhost:5173
# Origen público del API (https://api.ejemplo.com). Las peticiones GET por HTTP
# plano se redirigen (308) aquí; sin él se rechazan con 426.
PUBLIC_API_URL=
# Saltos de proxy de confianza (balanceador). Vacío = 1 en producción, 0 en desarrollo.
TRUST_PROXY=
# Swagger UI en /documentacion. Vacío = abierto en desarrollo, cerrado en producción.
ENABLE_DOCS=
# Correos (coma separada) autorizados a modificar catálogos GLOBALES (roles,
# permisos, formatos, plantillas…). Vacío = nadie; se gestionan por SQL/semilla.
PLATFORM_ADMIN_EMAILS=
# Rate limit de /auth/login y /auth/register (por IP). Vacío = valores por defecto.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────
# URL del proyecto y clave de SERVICE ROLE (solo backend: nunca al navegador,
# nunca en variables VITE_*, nunca en el repositorio ni en los logs).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Clave ANON/publishable: la usa el login (signInWithPassword) para no ejecutarse
# con la service role. Obligatoria en producción.
SUPABASE_ANON_KEY=

# ── Higgsfield (imagen y video con IA) ──────────────────────────────────────
# Documentación: https://open.higgsfield.ai/quick-start
# Sin API key, la API opera en modo simulado (HIGGSFIELD_SIMULATE=true).
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_API_KEY=
HIGGSFIELD_SIMULATE=true

# ── Meta Marketing API (campañas) ───────────────────────────────────────────
# Sin credenciales, la API opera en modo simulado (META_SIMULATE=true):
# guarda borradores, valida y deja recursos en PAUSED sin activar gasto.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_SIMULATE=true

# ── Multiempresa ────────────────────────────────────────────────────────────
# Organización por defecto para clientes que no envían el header X-Org-Id
DEFAULT_ORGANIZATION_ID=
